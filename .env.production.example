# Use an available pair of free subdomains with A records pointing to the VM public IP.
PUBLIC_APP_DOMAIN=idx-exchange-search.example-subdomain.org
ADMIN_APP_DOMAIN=idx-exchange-admin.example-subdomain.org
CADDY_EMAIL=you@example.com

# Generate these with URL-safe hexadecimal values. Do not commit the real .env.production file.
MYSQL_ROOT_PASSWORD=replace_with_a_long_hex_secret
MYSQL_DATABASE=real_estate
MYSQL_APP_USER=search_app
MYSQL_APP_PASSWORD=replace_with_a_long_hex_secret
API_DEMO_METRICS_TOKEN=replace_with_a_long_hex_secret

# Caddy expects a password hash, never plaintext. Example: caddy hash-password --algorithm argon2id.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_caddy_password_hash

# Absolute paths on the VM. Only the active snapshot and intent artifact belong here.
MODEL_DATA_DIR=/srv/idx-nlp-internship/data/models
MYSQL_SOURCE_SQL_PATH=/srv/idx-nlp-internship/data/raw/rets_property.sql

API_RATE_LIMIT_REQUESTS=12
API_RATE_LIMIT_WINDOW_SECONDS=10
API_RERANK_QUEUE_TIMEOUT_SECONDS=20
API_RERANK_K=50
API_RERANK_MAX_REMARK_CHARS=1500
